#ifndef INC_STM32F44XX_H_
#define INC_STM32F44XX_H_

#include <stdint.h>
/*
 * Memory base address
 */
#define FLASH_BASEADDR					0x08000000U
#define ROM_BASEADDR					0x1FFF0000U
#define SRAM1_BASEADDR					0x20000000U
#define SRAM2_BASEADDR					0x2001C000U
