#include <stdint.h>
#include "stm32f4xx.h"

int main(void)
{
    // Enable GPIOA clock
	GPIOA_CLK_EN();
    // PA5 as output
    GPIOA->MODER &= ~(3 << (5 * 2));
    GPIOA->MODER |=  (1 << (5 * 2));

    // Push-pull
    GPIOA->OTYPER &= ~(1 << 5);

    // Medium speed
    GPIOA->OSPEEDR &= ~(3 << (5 * 2));
    GPIOA->OSPEEDR |=  (1 << (5 * 2));

    // No pull-up, no pull-down
    GPIOA->PUPDR &= ~(3 << (5 * 2));

    // Set PA5 high
    GPIOA->ODR |= (1 << 5);

    while (1)
