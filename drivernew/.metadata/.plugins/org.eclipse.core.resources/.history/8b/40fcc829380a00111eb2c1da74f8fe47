#include <stdint.h>
#include "stm32f446xx.h"
#include "stm32_GPIO_Driver.h"



void delay(void)
{
    for(uint32_t i = 0; i < 100000; i++);
}

int main(void)
{
    GPIO_Handle_t led1, led2;

    led1.pGPIOx = GPIOA;							/* LED1 : PORTA3 */
    led1.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_3;
    led1.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    led1.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_LOW;
    led1.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

    led2.pGPIOx = GPIOA;										    /*  LED2 : PORTA2 */

    led2.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_2;
    led2.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    led2.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_LOW;
    led2.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;


    //Enable Clocks
    GPIO_PeriClockControl(GPIOA, ENABLE);
    GPIO_PeriClockControl(GPIOC, ENABLE);



    GPIO_Init(&led1);
    GPIO_Init(&led2);


    while(1)
    {


        //LED1 ON, LED2 OFF
        GPIO_WriteToOutputPin(GPIOA,GPIO_PIN_NO_3,ENABLE);
        GPIO_WriteToOutputPin(GPIOA,GPIO_PIN_NO_2,DISABLE);

        delay();


        /* LED1 OFF, LED2 ON */
        GPIO_WriteToOutputPin(GPIOA,GPIO_PIN_NO_2,DISABLE);
        GPIO_WriteToOutputPin(GPIOA,GPIO_PIN_NO_3,ENABLE);

        delay();
    }
}

